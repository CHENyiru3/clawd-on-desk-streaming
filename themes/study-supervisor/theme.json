{
  "schemaVersion": 1,
  "name": "Study Supervisor",
  "author": "Eric",
  "version": "1.0.0",
  "description": "GIF theme from clawd-tank captures — tuned for webcam study-supervisor control",
  "license": "MIT",

  "viewBox": { "x": -15, "y": -25, "width": 45, "height": 45 },

  "layout": {
    "contentBox": { "x": -4, "y": -3, "width": 23, "height": 20 },
    "centerX": 7.5,
    "baselineY": 17,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "_comment": "Disabled: idle uses GIF (clawd-idle.gif), not SVG.",
    "enabled": false,
    "states": [],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.5,
    "maxOffset": 3,
    "bodyScale": 0.33,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "7.5px 15px"
  },

  "states": {
    "idle":         ["clawd-idle.gif"],
    "thinking":     ["clawd-thinking.gif"],
    "working":      ["clawd-typing.gif"],
    "typing":       ["clawd-typing.gif"],
    "juggling":     ["clawd-juggling.gif"],
    "sweeping":     ["clawd-sweeping.gif"],
    "error":        ["clawd-confused.gif"],
    "attention":    ["clawd-thinking.gif"],
    "notification": ["clawd-sweeping.gif"],
    "carrying":     { "fallbackTo": "working" },
    "sleeping":     ["clawd-sleeping.gif"]
  },

  "sleepSequence": {
    "mode": "direct"
  },

  "workingTiers": [
    { "minSessions": 3, "file": "clawd-building.gif" },
    { "minSessions": 2, "file": "clawd-juggling.gif" },
    { "minSessions": 1, "file": "clawd-typing.gif" }
  ],

  "jugglingTiers": [
    { "minSessions": 2, "file": "clawd-juggling.gif" },
    { "minSessions": 1, "file": "clawd-juggling.gif" }
  ],

  "timings": {
    "minDisplay": {
      "error": 800,
      "attention": 800,
      "working": 500,
      "typing": 500,
      "thinking": 500
    },
    "autoReturn": {
      "attention": 4000,
      "error": 600000,
      "sweeping": 300000,
      "notification": 2500,
      "carrying": 3000
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "hitBoxes": {
    "default": { "x": -1, "y": 5, "w": 17, "h": 12 },
    "sleeping": { "x": -2, "y": 9, "w": 19, "h": 7 }
  },
  "sleepingHitboxFiles": ["clawd-sleeping.gif"],

  "miniMode": {
    "supported": false
  },

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
